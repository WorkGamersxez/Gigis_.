local function sendNativeM1()
	local char = player.Character
	if not char then return end
	pcall(function()
		local remoteFunction = char:FindFirstChild("RemoteFunction")
		if remoteFunction then
			remoteFunction:InvokeServer("Attack", "m1")
		end
	end)
end

local function startQLoop()
	if qLoopRunning then return end
	qLoopRunning = true
	task.spawn(function()
		while combatEnabled and qLoopRunning and isRunning do
			if getStandMorph() then break end
			pcall(function() VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Q, false, game) end)
			task.wait(0.04)
			pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Q, false, game) end)
			task.wait(CONFIG.Q_INTERVAL)
		end
		qLoopRunning = false
	end)
end

local function returnStandToPlayer()
	currentNPC = nil
	targetNpcHrp = nil
	local stand = getStandMorph()
	local _, humanoid, hrp = getCharacterElements()
	if stand and hrp and hrp.Parent then
		stand:PivotTo(hrp.CFrame * CFrame.new(0, 0, 3))
	end
	if humanoid then camera.CameraSubject = humanoid end
end

local function setCombatState(wantEnabled)
	if wantEnabled then
		local _, humanoid, _ = getCharacterElements()
		if not humanoid or humanoid.Health <= 0 then return end
		combatEnabled = true
		currentNPC = nil
		if not getStandMorph() then startQLoop() end
	else
		combatEnabled = false
		qLoopRunning = false
		returnStandToPlayer()
	end
end

local function findNearestTargetNPC()
	local char = player.Character
	local playerHrp = char and char:FindFirstChild("HumanoidRootPart")
	if not playerHrp then return nil end

	local closest = nil
	local shortestDist = math.huge
	local targetName = selectedMission.combatNpc

	for _, npc in ipairs(living:GetChildren()) do
		if npc:IsA("Model") then
			local matchFound = false
			if npc.Name == targetName then
				matchFound = true
			elseif targetName == "Jotaro" and npc.Name == "Jotaro" then
				matchFound = true
			elseif targetName == "DIO" and npc.Name == "DIO" then
				matchFound = true
			elseif string.lower(npc.Name) == string.lower(targetName) then
				matchFound = true
			end

			if matchFound then
				local health = getNPCHealth(npc)
				local root = getNPCHRP(npc)
				if health and health.Value > 0 and root then
					local dist = (playerHrp.Position - root.Position).Magnitude
					if dist < shortestDist then
						shortestDist = dist
						closest = npc
					end
				end
			end
		end
	end
	return closest
end

RunService.Heartbeat:Connect(function()
	if not combatEnabled or not isRunning then return end
	local _, humanoid, hrp = getCharacterElements()
	if not humanoid or humanoid.Health <= 0 or not hrp or not hrp.Parent then
		setCombatState(false)
		return
	end

	local stand = getStandMorph()
	if not stand then
		currentNPC = nil
		startQLoop()
		return
	end
	qLoopRunning = false

	if currentNPC then
		local health = getNPCHealth(currentNPC)
		local npcHrp = getNPCHRP(currentNPC)
		if not health or health.Value <= 0 or not npcHrp or not npcHrp.Parent then
			currentNPC = nil
		end
	end

	if not currentNPC then
		currentNPC = findNearestTargetNPC()
		if not currentNPC then
			returnStandToPlayer()
			return
		end
	end

	local npcHrp = getNPCHRP(currentNPC)
	if npcHrp then
		targetNpcHrp = npcHrp
		
		if stand and stand.PrimaryPart then
			camera.CameraSubject = stand.PrimaryPart
		end

		local playerTargetCFrame = npcHrp.CFrame - Vector3.new(0, CONFIG.PLAYER_BELOW, 0)
		pcall(function()
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
			hrp.CFrame = playerTargetCFrame
		end)

		sendNativeM1()
	end
end)

local function walkToNPC()
	currentStatus = "Viajando: " .. selectedMission.npcName
	setCombatState(false)

	local _, _, root = getCharacterElements()
	if not root then return false end

	pcall(function() root.Anchored = false end)
	local distance = (root.Position - selectedMission.npcPos).Magnitude
	if distance <= 5 then return true end

	local duration = distance / CONFIG.TWEEN_SPEED
	pcall(function()
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end)

	local tween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
		CFrame = CFrame.new(selectedMission.npcPos + Vector3.new(0, 1.5, 0))
	})

	local finished = false
	local connection = tween.Completed:Connect(function() finished = true end)
	tween:Play()

	local success = fastWait(function() return finished end, duration + 2)
	connection:Disconnect()

	if not success then
		tween:Cancel()
		return false
	end

	pcall(function() root.Anchored = true end)
	task.wait(0.2)
	pcall(function() root.Anchored = false end)
	return true
end

local function triggerPrompt()
	currentStatus = "Falando com: " .. selectedMission.npcName
	local folder = workspace:FindFirstChild("Dialogues")
	local npc = folder and folder:FindFirstChild(selectedMission.npcName)
	local prompt = npc and npc:FindFirstChildOfClass("ProximityPrompt")
	if not prompt then return false end

	prompt.RequiresLineOfSight = false
	prompt.HoldDuration = 0

	local ok = pcall(function() fireproximityprompt(prompt) end)
	if not ok then
		pcall(function()
			prompt:InputHoldBegin()
			task.wait(0.05)
			prompt:InputHoldEnd()
		end)
	end
	task.wait(0.4)
	return true
end

local function clearAllDialogues()
	currentStatus = "Aceitando..."

	local menuApareceu = fastWait(function() return isDialogueGuiActive() end, 3)
	if not menuApareceu then return false end

	local char = player.Character
	local remoteEvent = char and char:FindFirstChild("RemoteEvent")

	if remoteEvent then
		pcall(function()
			remoteEvent:FireServer("EndDialogue", {
				["NPC"] = selectedMission.npcName,
				["Option"] = "Option1",
				["Dialogue"] = "Dialogue1"
			})
		end)
	end

	local dialogueGui = playerGui:FindFirstChild("DialogueGui") or playerGui:FindFirstChild("Dialogue")
	if dialogueGui then
		local attempts = 0
		while isRunning and isDialogueGuiActive() and attempts < 15 do
			pcall(function()
				local frame = dialogueGui:FindFirstChild("Frame")
				if frame then
					local options = frame:FindFirstChild("Options")
					local clickContinue = frame:FindFirstChild("ClickContinue")

					if options and options:FindFirstChild("Option1") then
						local btn = options.Option1:FindFirstChildOfClass("TextButton") or options.Option1
						if firesignal then
							firesignal(btn.MouseButton1Click)
							firesignal(btn.Activated)
						end
					end

					if clickContinue then
						if firesignal then
							firesignal(clickContinue.MouseButton1Click)
							firesignal(clickContinue.Activated)
						end
					end
				end
			end)

			attempts = attempts + 1
			task.wait(CONFIG.SPAM_DELAY)
		end
	end

	task.wait(0.3)
	return true
end

local function executeHuntingFarming()
	currentStatus = "Caçando: " .. selectedMission.combatNpc
	setCombatState(true)
	task.wait(1.0)

	local killsDone = 0
	while isRunning and killsDone < selectedMission.killsNeeded do
		local target = findNearestTargetNPC()
		if target then
			local health = getNPCHealth(target)
			while isRunning and target and target.Parent and health and health.Value > 0 do
				task.wait(0.2)
			end
			killsDone = killsDone + 1
		else
			task.wait(0.5)
		end
	end

	task.wait(0.2)
	setCombatState(false)
	return true
end

local function runMasterFarmCycle()
	local steps = { walkToNPC, triggerPrompt, clearAllDialogues, executeHuntingFarming }
	for _, step in ipairs(steps) do
		if not isRunning then return end
		local success = step()
		if not success then
			setCombatState(false)
			task.wait(1.5)
			return
		end
	end
end

