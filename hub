local function getCharacterElements()
	local char = player.Character
	if not char then return nil, nil, nil end
	return char, char:FindFirstChild("Humanoid"), char:FindFirstChild("HumanoidRootPart")
end

local function getStandMorph()
	local playerModel = living:FindFirstChild(player.Name)
	return playerModel and playerModel:FindFirstChild("StandMorph")
end

local function getNPCHealth(npc)
	if not npc then return nil end
	local health = npc:FindFirstChild("Health")
	if health and health:IsA("DoubleConstrainedValue") then
		return health
	end
	return nil
end

local function getNPCHRP(npc)
	if not npc then return nil end
	return npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Torso") or npc:FindFirstChild("UpperTorso")
end

local function isDialogueGuiActive()
	return playerGui:FindFirstChild("DialogueGui") ~= nil or playerGui:FindFirstChild("Dialogue") ~= nil
end

local function fastWait(condition, timeout)
	local start = os.clock()
	while os.clock() - start < timeout do
		if not isRunning then return false end
		local success, result = pcall(condition)
		if success and result then return true end
		task.wait(0.08)
	end
	return false
end

local function createAntiFallPlatform()
	if antiFallPlatform and antiFallPlatform.Parent then return end
	antiFallPlatform = Instance.new("Part")
	antiFallPlatform.Name = "AntiFallPlatform"
	antiFallPlatform.Size = Vector3.new(6, 1, 6)
	antiFallPlatform.Anchored = true
	antiFallPlatform.CanCollide = true
	antiFallPlatform.Transparency = 1
	antiFallPlatform.Parent = workspace
end

local function updateAntiFallPlatform(hrp)
	if not hrp then return end
	createAntiFallPlatform()
	antiFallPlatform.CFrame = CFrame.new(hrp.Position - Vector3.new(0, 3.5, 0))
end

local function destroyAntiFallPlatform()
	if antiFallPlatform then
		antiFallPlatform:Destroy()
		antiFallPlatform = nil
	end
end

local function simularCliqueEscala(pos)
	local screenSize = camera.ViewportSize
	local x = pos.X * screenSize.X
	local y = pos.Y * screenSize.Y

	if isMobilePlayer() then
		for i = 1, 3 do
			VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
			task.wait(0.03)
			VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
			task.wait(0.02)
		end
	else
		VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
		task.wait(0.025)
		VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
	end
end

