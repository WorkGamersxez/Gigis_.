-- ======================
local function walkToNPC()
	if not selectedFarm then return false end
	currentStatus = "Indo até o NPC..."
	setCombatState(false)

	local character, humanoid, root = getCharacterElements()
	if not character or not root or not humanoid then return false end

	pcall(function()
		root.Anchored = false
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		humanoid.PlatformStand = false
	end)

	local targetPos = selectedFarm.npcPos + Vector3.new(0, 3, 0)
	local startPos = root.Position

	if (startPos - targetPos).Magnitude <= 10 then
		return true
	end

	local originalCanCollide = {}
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			originalCanCollide[part] = part.CanCollide
			part.CanCollide = false
		end
	end

	createAntiFallPlatform()

	currentStatus = "Indo até o NPC (Noclip)..."
	local SPEED = isMobilePlayer() and 90 or CONFIG.SPEED
	local startTime = os.clock()
	local maxTime = ((startPos - targetPos).Magnitude / SPEED) + 2

	while isRunning and (os.clock() - startTime) < maxTime do
		local current = root.Position
		local direction = (targetPos - current)
		if direction.Magnitude <= 6 then break end

		local step = math.min(SPEED * 0.018, direction.Magnitude)
		root.CFrame = CFrame.new(current + direction.Unit * step)
		updateAntiFallPlatform(root)
		task.wait()
	end

	pcall(function()
		root.CFrame = CFrame.new(targetPos)
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end)

	updateAntiFallPlatform(root)

	for part, canCollide in pairs(originalCanCollide) do
		if part and part.Parent then
			part.CanCollide = canCollide
		end
	end

	task.wait(0.4)
	return true
end

