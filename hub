local function triggerPrompt()
	if not selectedFarm then return false end
	currentStatus = "Ativando Prompt (E)"

	local folder = workspace:FindFirstChild("Dialogues")
	if not folder then return false end

	local npc = folder:FindFirstChild(selectedFarm.npcName)
	if not npc then
		for _, v in ipairs(folder:GetChildren()) do
			if string.find(string.lower(v.Name), string.lower(selectedFarm.npcName)) then
				npc = v
				break
			end
		end
	end
	if not npc then return false end

	local prompt = npc:FindFirstChildOfClass("ProximityPrompt")
	if not prompt then return false end

	prompt.RequiresLineOfSight = false
	prompt.MaxActivationDistance = 25

	pcall(function() fireproximityprompt(prompt) end)
	task.wait(0.15)

	pcall(function()
		prompt:InputHoldBegin()
		task.wait(prompt.HoldDuration + 0.1)
		prompt:InputHoldEnd()
	end)

	task.wait(0.1)
	pcall(function()
		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
		task.wait(0.12)
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
	end)

	task.wait(0.6)
	return true
end

local questAlreadyActivatedAtTeleport = false

-- ======================
-- TELEPORTE ALEATORIO APOS DERROTAR O NPC
-- Centro do raio: posicao configurada do NPC da missao.
-- O ciclo principal depois retorna ao NPC e ativa o prompt normalmente.
-- ======================
local function teleportRandomNearQuestNPC()
    if not selectedFarm or not isRunning then
        return false
    end

    local character, humanoid, root = getCharacterElements()
    if not character or not humanoid or not root or humanoid.Health <= 0 then
        return false
    end

    currentStatus = "Teleportando para perto do NPC da missao..."

    local center = selectedFarm.npcPos
    local angle = math.random() * math.pi * 2
    -- sqrt distribui os pontos de forma mais uniforme dentro do circulo.
    local radius = math.sqrt(math.random()) * 100
    local destination = Vector3.new(
        center.X + math.cos(angle) * radius,
        center.Y + 3,
        center.Z + math.sin(angle) * radius
    )

    local ok, err = pcall(function()
        root.Anchored = false
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        root.CFrame = CFrame.new(destination)
    end)

    if not ok then
        warn("[AutoFarm] Falha no teleporte aleatorio: " .. tostring(err))
        return false
    end

    task.wait(0.5)
    return isRunning
end

local function clearAllDialogues()
	currentStatus = "Fechando Diálogo..."

	local apareceu = fastWait(function()
		return isDialogueGuiActive()
	end, 5)

	if not apareceu then return false end

	local positions = {
		Vector2.new(0.50, 0.72),
		Vector2.new(0.50, 0.68),
		Vector2.new(0.50, 0.76),
		Vector2.new(0.50, 0.80),
		Vector2.new(0.50, 0.64),
		Vector2.new(0.50, 0.85),
		Vector2.new(0.50, 0.78),
		Vector2.new(0.6459, 0.6604),
		Vector2.new(0.62, 0.70),
		Vector2.new(0.38, 0.70),
		Vector2.new(0.50, 0.90),
		Vector2.new(0.50, 0.55),
	}

	local maxTime = isMobilePlayer() and 14 or 9
	local start = os.clock()

	while isRunning and isDialogueGuiActive() and (os.clock() - start) < maxTime do
		for _, pos in ipairs(positions) do
			if not isDialogueGuiActive() then break end
			pcall(simularCliqueEscala, pos)
			task.wait(isMobilePlayer() and 0.06 or 0.035)
		end
		task.wait(0.08)
	end

	task.wait(0.5)
	return true
end

local function executeHuntingFarming()
	if not selectedFarm then return false end

	currentStatus = "Farmando: " .. selectedFarm.combatNpc
	setCombatState(true)
	task.wait(1.2)

	local stuckTime = 0
	local npcMorreu = false

	while isRunning do
		currentStatus = "Atacando: " .. selectedFarm.combatNpc

		if currentNPC then
			local health = getNPCHealth(currentNPC)
			-- Detecta a morte do NPC atual
			if not health or health.Value <= 0 then
				print("[AutoFarm] NPC Derrotado! Reiniciando ciclo...")
				npcMorreu = true
				break
			end
		end

		if not currentNPC then
			stuckTime = stuckTime + 0.6
			if stuckTime > 15 then -- Reduzido para achar novos alvos mais rápido
				warn("[AutoFarm] Procurando novo NPC...")
				break
			end
		else
			stuckTime = 0
		end

		task.wait(0.3) -- Loop mais rápido para detecção instantânea
	end

	-- Encerra o combate e restaura a camera.
local function setCombatState(wantEnabled)
	if wantEnabled then
		local _, humanoid = getCharacterElements()
		if not humanoid or humanoid.Health <= 0 then return end
		combatEnabled = true
		currentNPC = nil
		if not getStandMorph() then
			startQLoop()
		end
		startAutoClick()
	else
		combatEnabled = false
		autoClickRunning = false
		qLoopRunning = false
		returnStandToPlayer() -- <-- ESTA LINHA TRAZ O STAND DE VOLTA
	end
end


	-- Ao derrotar o inimigo, teleporta para um ponto aleatorio num raio de 100 studs
	-- e tenta ativar a missao desse local, sem caminhar de volta ate o NPC.
	if npcMorreu and isRunning then
		-- Mantem o Stand 20 studs ABAIXO do personagem apos a derrota.
		positionStandAbovePlayer(-20)

		if teleportRandomNearQuestNPC() then
			-- Reposiciona novamente, pois o personagem mudou de local.
			task.wait(0.1)
			positionStandAbovePlayer(-20)
			task.wait(0.25)
			if triggerPrompt() then
				clearAllDialogues()
				questAlreadyActivatedAtTeleport = true
			end
		else
			-- Se o teleporte falhar, deixa o Stand abaixo do personagem mesmo assim.
			positionStandAbovePlayer(-20)
		end
	end

	return true
end

-- ======================
-- CICLO PRINCIPAL
-- ======================
local function runMasterFarmCycle()
	-- Se a missao ja foi ativada logo apos o teleporte, nao repetir os passos do NPC.
	if not isRunning then return end
	if questAlreadyActivatedAtTeleport then
		questAlreadyActivatedAtTeleport = false
	else
		if not walkToNPC() then return end
		if not isRunning then return end
		if not triggerPrompt() then return end
		if not isRunning then return end
		if not clearAllDialogues() then return end
	end

	if not isRunning then return end
	executeHuntingFarming()
	-- Ao terminar o executeHuntingFarming, a função acaba e o "startBot" inicia tudo do zero
end

local function startBot()
	if isRunning or not selectedFarm then return end
	isRunning = true
	task.spawn(function()
		while isRunning do
			runMasterFarmCycle()
			task.wait(1.2)
		end
		currentStatus = "Aguardando"
	end)
end

local function stopBot()
	isRunning = false
	setCombatState(false)
	destroyAntiFallPlatform()
	pcall(function()
		local _, _, root = getCharacterElements()
		if root then root.Anchored = false end
	end)
end

