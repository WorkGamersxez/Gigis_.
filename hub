	local Card = Instance.new("Frame")
	Card.Size = UDim2.new(1, -6, 0, 62)
	Card.BackgroundColor3 = (item == selectedMission) and Color3.fromRGB(25, 45, 80) or Color3.fromRGB(18, 22, 28)
	Card.BorderSizePixel = 0
	Card.Parent = ScrollContainer

	local CardStroke = Instance.new("UIStroke")
	CardStroke.Color = (item == selectedMission) and Color3.fromRGB(100, 160, 255) or Color3.fromRGB(40, 50, 65)
	CardStroke.Thickness = 1
	CardStroke.Parent = Card

	local InfoText = Instance.new("TextLabel")
	InfoText.Size = UDim2.new(0.68, 0, 1, -8)
	InfoText.Position = UDim2.new(0, 10, 0, 4)
	InfoText.BackgroundTransparency = 1
	InfoText.TextColor3 = Color3.fromRGB(220, 225, 235)
	InfoText.Font = Enum.Font.Gotham
	InfoText.TextSize = 11
	InfoText.TextXAlignment = Enum.TextXAlignment.Left
	InfoText.TextYAlignment = Enum.TextYAlignment.Top
	InfoText.Text = string.format(
		"<b>%s</b>\nNPC: <font color='#80B5FF'>%s</font> | Alvo: <font color='#FF8080'>%s</font> (x%d)",
		item.name, item.npcName, item.combatNpc, item.killsNeeded
	)
	InfoText.RichText = true
	InfoText.Parent = Card

	local SelectBtn = Instance.new("TextButton")
	SelectBtn.Size = UDim2.new(0.28, 0, 0, 36)
	SelectBtn.Position = UDim2.new(0.7, -4, 0.5, -18)
	SelectBtn.BackgroundColor3 = Color3.fromRGB(230, 235, 245)
	SelectBtn.Text = "SELECIONAR"
	SelectBtn.TextColor3 = Color3.fromRGB(15, 25, 45)
	SelectBtn.Font = Enum.Font.GothamBold
	SelectBtn.TextSize = 10
	SelectBtn.Parent = Card

	itemButtons[i] = {card = Card, stroke = CardStroke}

	SelectBtn.MouseButton1Click:Connect(function()
		selectedMission = item
		for _, data in pairs(itemButtons) do
			data.card.BackgroundColor3 = Color3.fromRGB(18, 22, 28)
			data.stroke.Color = Color3.fromRGB(40, 50, 65)
		end
		Card.BackgroundColor3 = Color3.fromRGB(25, 45, 80)
		CardStroke.Color = Color3.fromRGB(100, 160, 255)
	end)
end

-- DragClick
local dragging, dragStart, startPos
Header.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = MainFrame.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then dragging = false end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

ActivateBtn.MouseButton1Click:Connect(function()
	isRunning = not isRunning

	if isRunning then
		ActivateBtn.Text = "DESLIGAR FARM"
		ActivateBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
		task.spawn(function()
			while isRunning do
				runMasterFarmCycle()
				task.wait(1.0)
			end
			currentStatus = "Aguardando"
		end)
	else
		ActivateBtn.Text = "LIGAR FARM"
		ActivateBtn.BackgroundColor3 = Color3.fromRGB(30, 90, 200)
		setCombatState(false)
		destroyAntiFallPlatform()
	end
end)

task.spawn(function()
	while ScreenGui.Parent do
		StatusText.Text = "Status: " .. currentStatus
		task.wait(0.2)
	end
end)

print("✅ Script e sistema de memorização de aviso carregados com sucesso!")
