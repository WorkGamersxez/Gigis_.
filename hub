-- ======================
RunService.RenderStepped:Connect(function()
	if isRunning then
		-- Noclip constante
		if player.Character then
			for _, part in pairs(player.Character:GetDescendants()) do
				if part:IsA("BasePart") then part.CanCollide = false end
			end
			local _, _, hrp = getCharacterElements()
			if hrp then
				if not antiFallPlatform or not antiFallPlatform.Parent then
					antiFallPlatform = Instance.new("Part")
					antiFallPlatform.Name = "NorthAntiFall"
					antiFallPlatform.Size = Vector3.new(10, 1, 10)
					antiFallPlatform.Anchored = true
					antiFallPlatform.CanCollide = true
					antiFallPlatform.Transparency = 1
					antiFallPlatform.Parent = workspace
				end
				antiFallPlatform.CFrame = hrp.CFrame - Vector3.new(0, 3.5, 0)
			end
		end

		-- Trava do Stand atrás do NPC
		if targetNpcHrp and targetNpcHrp.Parent then
			local stand = getStandMorph()
			if stand and stand.PrimaryPart then
				local targetCFrame = targetNpcHrp.CFrame * CFrame.new(0, CONFIG.FLOAT_HEIGHT, CONFIG.DISTANCE_BEHIND)
				stand.PrimaryPart.CFrame = targetCFrame
				stand.PrimaryPart.AssemblyLinearVelocity = Vector3.zero
				stand.PrimaryPart.AssemblyAngularVelocity = Vector3.zero
				stand:PivotTo(targetCFrame)
			end
		end
	end
end)

local function destroyAntiFallPlatform()
	if antiFallPlatform then
		antiFallPlatform:Destroy()
		antiFallPlatform = nil
	end
end

