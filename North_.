local function checkAndAutoPlayLobby()
	task.spawn(function()
		while task.wait(0.5) do
			local loadingScreen = playerGui:FindFirstChild("LoadingScreen")
			if not loadingScreen then break end

			local frames = loadingScreen:FindFirstChild("Frames")
			if frames then
				-- 1. Clique na Tela Principal do Lobby (Frames.Main.Play)
				local mainFrame = frames:FindFirstChild("Main")
				local mainPlayBtn = mainFrame and mainFrame:FindFirstChild("Play")

				if mainPlayBtn and mainPlayBtn.Visible then
					print("🎮 [North_.] Clicando em Play (Lobby Principal)...")
					if firesignal then
						pcall(function() firesignal(mainPlayBtn.MouseButton1Click) end)
						pcall(function() firesignal(mainPlayBtn.Activated) end)
					else
						pcall(function()
							local pos = mainPlayBtn.AbsolutePosition + (mainPlayBtn.AbsoluteSize / 2)
							VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
							task.wait(0.05)
							VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
						end)
					end
				end

				-- 2. Clique no Modo de Jogo MainGame (Frames.Gamemodes.MainGame.Play)
				local gamemodes = frames:FindFirstChild("Gamemodes")
				local mainGame = gamemodes and gamemodes:FindFirstChild("MainGame")
				local modePlayBtn = mainGame and mainGame:FindFirstChild("Play")

				if modePlayBtn and modePlayBtn.Visible then
					print("🎮 [North_.] Clicando em Play (Main Game)...")
					if firesignal then
						pcall(function() firesignal(modePlayBtn.MouseButton1Click) end)
						pcall(function() firesignal(modePlayBtn.Activated) end)
					else
						pcall(function()
							local pos = modePlayBtn.AbsolutePosition + (modePlayBtn.AbsoluteSize / 2)
							VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
							task.wait(0.05)
							VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
						end)
					end
				end
			end
		end
	end)
end

