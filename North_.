local dragging, dragStart, startPos
Header.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = MainFrame.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then dragging = false end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

ActivateQuestBtn.MouseButton1Click:Connect(function()
	isRunning = not isRunning
	if isRunning then
		ActivateQuestBtn.Text = "PARAR QUESTS"
		ActivateQuestBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
		task.spawn(function()
			while isRunning do
				runMasterFarmCycle()
				task.wait(1.0)
			end
			currentStatus = "Aguardando"
		end)
	else
		ActivateQuestBtn.Text = "LIGAR QUESTS"
		ActivateQuestBtn.BackgroundColor3 = Color3.fromRGB(30, 90, 200)
		setCombatState(false)
		destroyAntiFallPlatform()
	end
end)

ActivateItemBtn.MouseButton1Click:Connect(function()
