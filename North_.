local function getCharacterElements()
	local char = player.Character
	if not char then return nil, nil, nil end
	return char, char:FindFirstChild("Humanoid"), char:FindFirstChild("HumanoidRootPart")
end

local function getStandMorph()
	local playerModel = living:FindFirstChild(player.Name)
	return playerModel and (playerModel:FindFirstChild("StandMorph") or playerModel:FindFirstChild("Stand"))
end

local function getNPCHealth(npc)
	if not npc then return nil end
	local health = npc:FindFirstChild("Health")
	return (health and health:IsA("DoubleConstrainedValue")) and health or nil
end

local function getNPCHRP(npc)
	if not npc then return nil end
	return npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Torso") or npc:FindFirstChild("UpperTorso")
end

local function isDialogueGuiActive()
	return playerGui:FindFirstChild("DialogueGui") ~= nil or playerGui:FindFirstChild("Dialogue") ~= nil
end

local function fastWait(condition, timeout)
	local start = os.clock()
	while os.clock() - start < timeout do
		if not isRunning and not isItemFarming then return false end
		local success, result = pcall(condition)
		if success and result then return true end
		task.wait(0.1)
	end
	return false
end

local function interactViaRemote(prompt)
	local char = player.Character
	local remoteEvent = char and char:FindFirstChild("RemoteEvent")
	
	if remoteEvent then
		pcall(function()
			remoteEvent:FireServer("Interact", prompt)
		end)
	end

	if prompt then
		prompt.RequiresLineOfSight = false
		prompt.HoldDuration = 0
		pcall(function() fireproximityprompt(prompt) end)
	end
end

local function isItemSelected(itemName)
	local count = 0
	for _ in pairs(selectedItems) do count = count + 1 end
	if count == 0 then return true end
	
	for name, enabled in pairs(selectedItems) do
		if enabled and string.find(string.lower(itemName), string.lower(name)) then
			return true
		end
	end
	return false
end

local function runItemFarmCycle()
	currentStatus = "Procurando Itens..."

	for _, prompt in ipairs(workspace:GetDescendants()) do
		if not isItemFarming then break end

		if prompt:IsA("ProximityPrompt") then
			local objectTextName = prompt.ObjectText
			local parentName = prompt.Parent and prompt.Parent.Name or ""

			if (objectTextName ~= "" and isItemSelected(objectTextName)) or isItemSelected(parentName) then
				local targetPart = prompt.Parent:IsA("BasePart") and prompt.Parent or prompt.Parent:FindFirstChildOfClass("BasePart")
				local _, _, playerHrp = getCharacterElements()

				if targetPart and playerHrp then
					local itemDisplayName = (objectTextName ~= "") and objectTextName or parentName
					currentStatus = "Coletando: " .. itemDisplayName
					
					playerHrp.CFrame = targetPart.CFrame * CFrame.new(0, 2, 0)
					task.wait(0.2)

					interactViaRemote(prompt)
					
					task.wait(0.4)
				end
			end
		end
	end
end

