-- Detecta se é Mobile
local function isMobilePlayer()
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

-- Clique melhorado (funciona melhor no Mobile)
local function simularCliqueEscala(pos)
	local screenSize = camera.ViewportSize
	local x = pos.X * screenSize.X
	local y = pos.Y * screenSize.Y

	if isMobilePlayer() then
		-- Método mais estável no Mobile
		VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
		task.wait(0.04)
		VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
	else
		-- Método normal (PC)
		VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
		task.wait(0.02)
		VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
	end
end
